{
  "manifest_version": 3,
  "name": "Dland Language - Sổ Tay & Tra Mazii",
  "version": "1.0.0",
  "description": "Tiện ích mở rộng hiển thị toàn bộ sổ tay, tự động hiện tooltip tra cứu Mazii khi bôi đen từ vựng trên mọi trang web và lưu nhanh vào sổ tay Dland Flashcard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dland Language - Quản Lý Sổ Tay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "https://mazii.net/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
