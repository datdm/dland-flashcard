{
  "manifest_version": 3,
  "name": "Dland Language - Sổ Tay & Tra Mazii",
  "version": "1.1.0",
  "description": "Hiển thị toàn bộ sổ tay, đồng bộ tài khoản & Database với web app Dland Language, tra cứu Mazii nhanh khi bôi đen từ vựng tiếng Nhật trên mọi trang web.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dland Language - Sổ Tay & Đồng Bộ Database",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://flashcard-japanese-eight.vercel.app/*",
    "https://mazii.net/*",
    "http://localhost:3000/*",
    "http://localhost:3001/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
